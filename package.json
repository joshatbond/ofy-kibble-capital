{
  "name": "ofy-kibble-capital",
  "version": "0.1.1",
  "private": true,
  "packageManager": "bun@1.2.5",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "theme:tones": "bun scripts/generate-theme-tone-css.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "netlify": "netlify"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.92",
    "@convex-dev/react-query": "^0.1.0",
    "@djpanda/convex-authz": "^0.1.7",
    "@djpanda/convex-tenants": "^0.1.6",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource-variable/rubik": "^5.2.8",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.167.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.36.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@netlify/vite-plugin-tanstack-start": "^1.3.12",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/preview-api": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/bun": "^1.3.6",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "culori": "^4.0.2",
    "eslint-plugin-react": "^7.37.5",
    "netlify-cli": "^26.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "8.6.18",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.9"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "@storybook/csf-plugin": "8.6.18",
    "@storybook/builder-vite": "8.6.18"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "htmlWhitespaceSensitivity": "ignore",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 80,
    "semi": false,
    "singleAttributePerLine": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "tailwindFunctions": [
      "clsx",
      "cx"
    ]
  }
}
